# Parly Unhosted MCP only. The new Hosted MCP must never load an agent key.
AGENT_PRIVATE_KEY=0xREPLACE_WITH_AGENT_PRIVATE_KEY

# Leave PORT unset for trusted local stdio. HTTP requires a distinct operator token.
# PORT=8181
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_AUTH_TOKEN=
# Non-loopback binding requires your own TLS proxy and this HTTPS origin.
# MCP_HTTP_PUBLIC_ORIGIN=https://operator.example.com

MCP_TEMPO_PROFILE=phase3-tempo4217
TEMPO_RPC_URL=https://rpc.tempo.xyz
TEMPO_CHAIN_ID=4217
SETTLEMENT_DOMAIN_ID=4217

PONDER_GRAPHQL_URL=http://localhost:42069/graphql
PARLY_SDK_ASSETS_PATH=

ENABLE_MPP_ADAPTER=true
MPP_SERVICE_NAME=parly-mpp-adapter
MPP_SERVICE_VERSION=16.9.9
