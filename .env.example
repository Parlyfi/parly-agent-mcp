# Agent Selfhost MCP execution wallet, stored only by its operator.
AGENT_PRIVATE_KEY=0xREPLACE_WITH_AGENT_PRIVATE_KEY

# Leave PORT unset for trusted local stdio. HTTP requires its own random operator token.
# PORT=8181
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_AUTH_TOKEN=
# Required only for non-loopback binding, behind your TLS reverse proxy.
# MCP_HTTP_PUBLIC_ORIGIN=https://operator.example.com

MCP_TEMPO_PROFILE=phase3-tempo4217
TEMPO_RPC_URL=https://rpc.tempo.xyz
TEMPO_CHAIN_ID=4217
SETTLEMENT_DOMAIN_ID=4217

PONDER_GRAPHQL_URL=https://indexer.example.parly.fi/graphql

# Optional if your deployment uses a custom proof asset path.
PARLY_SDK_ASSETS_PATH=

# CurrentParlySDKConfig JSON: explicit profile, deployment/recovery/reward/V7 pins.
PARLY_CURRENT_SDK_CONFIG_JSON=
# Absolute file path in an existing private directory; retain across restarts.
PARLY_CURRENT_STORAGE_PATH=

ENABLE_MPP_ADAPTER=true
MPP_SERVICE_NAME=parly-mpp-adapter
MPP_SERVICE_VERSION=16.9.9

# Optional: enables public web API helpers for Privacy Links, payments, Verify, and relayer flows.
PARLY_WEB_API_BASE_URL=
# Outbound API credential: never reuse it as MCP_HTTP_AUTH_TOKEN.
PARLY_MCP_WEB_API_BEARER_TOKEN=
